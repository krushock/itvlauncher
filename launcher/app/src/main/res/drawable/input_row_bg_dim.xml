<?xml version="1.0" encoding="utf-8"?>
<!-- Text box in a glass popup: a faint fill, a bright rim while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_fill_focused" />
            <stroke android:width="2dp" android:color="@color/field_stroke" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_fill" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
