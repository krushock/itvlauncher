<?xml version="1.0" encoding="utf-8"?>
<!-- Mac-style "joining a network": the arcs light up one after another. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <item android:drawable="@drawable/ic_wifi_connecting_0" android:duration="280" />
    <item android:drawable="@drawable/ic_wifi_connecting_1" android:duration="280" />
    <item android:drawable="@drawable/ic_wifi_connecting_2" android:duration="280" />
    <item android:drawable="@drawable/ic_wifi_connecting_3" android:duration="420" />
</animation-list>
