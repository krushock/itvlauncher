<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_focused" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/pill_fill_top" android:endColor="@color/pill_fill_bottom" />
            <stroke android:width="1dp" android:color="@color/pill_stroke" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
