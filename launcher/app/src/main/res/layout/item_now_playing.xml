<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing at the top of Controls: artwork, title and artist, and previous / play-pause / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="360dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/npArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:background="@drawable/tile_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/npTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <TextView
            android:id="@+id/npSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

    <ImageView
        android:id="@+id/npPrev"
        style="@style/NowPlayingButton"
        android:src="@drawable/ic_prev"
        android:contentDescription="@string/previous" />

    <ImageView
        android:id="@+id/npPlay"
        style="@style/NowPlayingButton"
        android:src="@drawable/ic_pause"
        android:contentDescription="@string/play_pause" />

    <ImageView
        android:id="@+id/npNext"
        style="@style/NowPlayingButton"
        android:src="@drawable/ic_next"
        android:contentDescription="@string/next" />
</LinearLayout>
