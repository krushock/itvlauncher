<?xml version="1.0" encoding="utf-8"?>
<!-- A Top Shelf card: the app's artwork for one show or film, a progress bar for Continue watching, and its title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/shelfCard"
        android:layout_width="200dp"
        android:layout_height="112dp"
        android:background="@drawable/tile_bg"
        android:foreground="@drawable/folder_tile_focus"
        android:focusable="true"
        android:clickable="true">

        <!-- Shown until the artwork loads, and instead of it when there's no connection. -->
        <TextView
            android:id="@+id/shelfFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:fontFamily="@font/outfit" />

        <ImageView
            android:id="@+id/shelfArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/shelfTrack"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/progress_track"
            android:visibility="gone" />

        <View
            android:id="@+id/shelfProgress"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/progress_fill"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/shelfTitle"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
