<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Full-screen artwork of the focused Top Shelf card, as on Apple TV, under a gradient that keeps text readable. -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/backdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backdrop_scrim"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="@color/text_primary"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- Top Shelf: the focused dock app's Continue watching and previews, positioned above the dock in code. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelf"
        android:layout_width="match_parent"
        android:layout_height="152dp"
        android:paddingStart="60dp"
        android:paddingEnd="56dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:alpha="0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping up here, so the end buttons' edge bump can go past the bar's bounds. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.22"
                        android:textAllCaps="true" />

                    <!-- Weather from Open-Meteo, once a city is set in Controls. -->
                    <LinearLayout
                        android:id="@+id/weatherBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/weatherIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:tint="@color/text_secondary"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/weatherText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.12"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="@color/text_primary"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/divider" />

                    <TextClock
                        android:id="@+id/date"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <!-- Now Playing, as on Apple TV: shown while something plays (and for a while after pausing);
                     OK opens the player, holding OK opens the app. -->
                <LinearLayout
                    android:id="@+id/btnNowPlaying"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/pill_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone"
                    android:contentDescription="@string/now_playing"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:id="@+id/npPillArt"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/npPillTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:maxWidth="240dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:duplicateParentState="true"
                        android:textColor="@drawable/pill_text"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500" />

                    <com.krushock.itvlauncher.PlayingBars
                        android:id="@+id/npPillBars"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="10dp"
                        android:duplicateParentState="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnSearch"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search"
                    android:nextFocusDown="@+id/grid" />

                <!-- Apple TV's App Switcher: the apps you used last, as a row of cards over Home. -->
                <ImageView
                    android:id="@+id/btnRecent"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_recent_bar"
                    android:contentDescription="@string/recent"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnInputs"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_input"
                    android:contentDescription="@string/inputs"
                    android:nextFocusDown="@+id/grid" />

                <!-- The icon shows the connection (Wi-Fi, Ethernet, offline); the network name is its description. -->
                <ImageView
                    android:id="@+id/btnWifi"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_wifi"
                    android:contentDescription="@string/wifi"
                    android:nextFocusDown="@+id/grid" />

                <!-- Notifications: a red dot when there are any. Hidden when the listener isn't switched on. -->
                <ImageView
                    android:id="@+id/btnNotifications"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="@string/notifications"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnControls"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_controls"
                    android:contentDescription="@string/controls"
                    android:nextFocusDown="@+id/grid" />

            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells.
             It reaches 32 dp into the screen margins (the grid pads them back), so the dock band's rounded ends and
             the focused tile at either end of a row have room even at 6 tiles per row. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:layout_marginStart="-32dp"
            android:layout_marginEnd="-32dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Full-screen Top Shelf, as the Apple TV app's: one title over its artwork, Play / More Info, page dots.
         Appears after resting on a shelf card; Left/Right page, Down or Back returns to the card. -->
    <FrameLayout
        android:id="@+id/fullShelf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="68dp"
            android:layout_marginBottom="64dp"
            android:orientation="vertical"
            android:clipChildren="false">

            <TextView
                android:id="@+id/fsApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.2"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/fsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxWidth="900dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_primary"
                android:textSize="56sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/fsSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/fsDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="680dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginStart="-10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/fsPlay"
                    style="@style/TopButton"
                    android:text="@string/play"
                    android:drawableStart="@drawable/ic_play" />

                <TextView
                    android:id="@+id/fsInfo"
                    style="@style/TopButton"
                    android:text="@string/more_info"
                    android:drawableStart="@drawable/ic_info" />

                <LinearLayout
                    android:id="@+id/fsDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.krushock.itvlauncher.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
