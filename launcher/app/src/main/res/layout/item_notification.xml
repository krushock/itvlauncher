<?xml version="1.0" encoding="utf-8"?>
<!-- One notification in the bell's panel: the app's icon, title, text and how long ago. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="460dp"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/nIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="380dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@drawable/pill_text"
            android:duplicateParentState="true"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <TextView
            android:id="@+id/nText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="380dp"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@drawable/pill_text_dim"
            android:duplicateParentState="true"
            android:textSize="13sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

    <TextView
        android:id="@+id/nTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.04" />
</LinearLayout>
